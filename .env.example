# ShiftTrack environment variables
#
# Copy this file to `.env` (or export the values in your shell) and restart the
# Expo dev server. Expo inlines every `EXPO_PUBLIC_*` variable into the bundle
# at build time, so changing one requires a restart.
#
# The app runs with sensible defaults if this file is absent.

# ---------------------------------------------------------------------------
# Target backend (only used when the mock API layer is disabled)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://api.shifttrack.test
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# In-app mock API layer
# ---------------------------------------------------------------------------
# Default: ON in a development build, OFF in a release build. Setting this
# explicitly always wins, so `true` opts a release build back into the mock
# (useful for a production-mode demo) and `false` disables it everywhere.
EXPO_PUBLIC_MOCK_API=true

# Artificial round-trip latency in milliseconds (set 0 for instant responses).
EXPO_PUBLIC_MOCK_LATENCY_MS=650

# `true` boots the app with every mock request failing, so the error / retry
# states are visible immediately. Can also be toggled at runtime from the
# "Mock API controls" card (development builds only).
EXPO_PUBLIC_MOCK_ERRORS=false
